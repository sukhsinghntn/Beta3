@page "/forms/{FormId:int}/responses"
@using System.Net.Http.Json
@using System.Net
@using System.Text
@using System.Text.Json
@using System.Linq
@using System.Collections.Generic
@using System
@using DynamicFormsApp.Shared.Models
@using Microsoft.AspNetCore.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject CookieHelper CookieHelper
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="container mt-4">
    <h2 class="mb-4">📄 Responses: <span class="text-primary">@form?.Name</span></h2>
    <p class="text-muted">@form?.Description</p>
    @if (unavailableInfo != null)
    {
        <FormUnavailableDisplay Info="@unavailableInfo" />
    }
    else if (!string.IsNullOrEmpty(deletedMessage))
    {
        <div class="alert alert-warning">@deletedMessage</div>
    }

    @if (form == null || responses == null)
    {
        <div class="alert alert-info">Loading responses...</div>
    }
    else if (!responses.Any())
    {
        <div class="alert alert-warning">No responses yet.</div>
    }
    else
    {
        <div class="mb-3">
            <button class="btn btn-outline-info me-2" @onclick="DownloadCsv">Download CSV</button>
            <button class="btn btn-outline-info" @onclick="DownloadPdf">Download PDF</button>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <input class="form-control" placeholder="Filter by Response ID" @bind="responseIdFilter" />
            </div>
            @if (columns.Contains("ResponderName"))
            {
                <div class="col-md-3">
                    <input class="form-control" placeholder="Filter by Submitted By" @bind="submitFilter" />
                </div>
            }
            <div class="col-md-3">
                <select class="form-select" @bind="statusFilter">
                    <option value="">All Statuses</option>
                    @foreach (var opt in statusOptions)
                    {
                        <option value="@opt">@statusIcons.GetValueOrDefault(opt, "🏷️") @opt</option>
                    }
                </select>
            </div>
        </div>
        <div class="table-responsive">
            <table id="responsesTable" class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        @foreach (var col in columns)
                        {
                            <th scope="col">@(col == "ResponderName" ? "Submitted By" : col)</th>
                        }
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredResponses)
                    {
                        <tr>
                            @foreach (var col in columns)
                            {
                                <td>
                                    @{ var field = form.Fields.FirstOrDefault(f => f.Key == col); }
                                @if (col != "ResponseId" && col != "CreatedAt" && col != "Status" && IsFileField(col))
                                {
                                        var url = row[col]?.ToString();
                                        if (!string.IsNullOrWhiteSpace(url))
                                        {
                                            if (url.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <iframe src="@($"/" + url)" width="100%" height="200px" style="border: none;"></iframe>
                                            }
                                            else if (IsImage(url))
                                            {
                                                <img src="@($"/" + url)" class="img-thumbnail" style="max-height: 120px;" />
                                            }
                                            else
                                            {
                                                <a class="btn btn-sm btn-outline-primary" href="@($"/" + url)" target="_blank">Open File</a>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">No file</span>
                                        }
                                    }
                                else if (col == "Status")
                                {
                                    row.TryGetValue(col, out var statusVal);
                                    <select class="form-select form-select-sm" value="@statusVal?.ToString()" @onchange='e => OnStatusChanged(row, e.Value?.ToString())'>
                                        <option value="">No Label</option>
                                        @foreach (var opt in statusOptions)
                                        {
                                            <option value="@opt">@statusIcons.GetValueOrDefault(opt, "🏷️") @opt</option>
                                        }
                                        <option value="__custom">+ Add label...</option>
                                    </select>
                                }
                                else if (col == "CreatedAt")
                                {
                                    <div>@FormatDateTime(row[col]?.ToString())</div>
                                }
                                else if (field?.FieldType == "grid_text")
                                {
                                    @RenderGridText(row[col]?.ToString(), field)
                                }
                                    else if (field?.FieldType == "grid_radio")
                                    {
                                        @RenderGridRadio(row[col]?.ToString(), field)
                                    }
                                    else if (field?.FieldType == "grid_checkbox")
                                    {
                                        @RenderGridCheckbox(row[col]?.ToString(), field)
                                    }
                                    else if (field?.FieldType == "date")
                                    {
                                        <div>@FormatDate(row[col]?.ToString())</div>
                                    }
                                    else if (field?.FieldType == "datetime")
                                    {
                                        <div>@FormatDateTime(row[col]?.ToString())</div>
                                    }
                                    else
                                    {
                                        <div style="white-space: pre-wrap;">@FormatValue(row[col])</div>
                                    }
                                </td>
                            }
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="@($"/forms/{FormId}/responses/{row["ResponseId"]}")">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public int FormId { get; set; }

    private Form form;
    private List<Dictionary<string, object>> responses;
    private string[] columns = Array.Empty<string>();
    private IJSObjectReference? exportModule;
    private string? deletedMessage;
    private DeletedFormInfo? unavailableInfo;
    private List<string> statusOptions = new() { "Approved", "Pending", "Rejected" };
    private Dictionary<string, string> statusIcons = new()
    {
        ["Approved"] = "✅",
        ["Pending"] = "⏳",
        ["Rejected"] = "❌"
    };
    private List<string> iconChoices = new() { "🏷️", "✅", "⏳", "❌", "⭐", "⚠️", "📌" };
    private string responseIdFilter = string.Empty;
    private string submitFilter = string.Empty;
    private string statusFilter = string.Empty;
    private IEnumerable<Dictionary<string, object>> FilteredResponses =>
        responses.Where(row =>
            (string.IsNullOrWhiteSpace(responseIdFilter) || row["ResponseId"].ToString().Contains(responseIdFilter, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(statusFilter) || (row.TryGetValue("Status", out var st) && (st?.ToString() ?? "") == statusFilter)) &&
            (string.IsNullOrWhiteSpace(submitFilter) || (row.TryGetValue("ResponderName", out var rn) && rn?.ToString()?.Contains(submitFilter, StringComparison.OrdinalIgnoreCase) == true)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var user = await CookieHelper.LoginStatus();
            if (string.IsNullOrEmpty(user))
            {
                var ret = Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri));
                Navigation.NavigateTo($"login?returnUrl={ret}", true);
                return;
            }


            var respForm = await Http.GetAsync($"api/forms/{FormId}");
            if (!respForm.IsSuccessStatusCode)
            {
                if (respForm.StatusCode == HttpStatusCode.Gone)
                {
                    unavailableInfo = await respForm.Content.ReadFromJsonAsync<DeletedFormInfo>();
                }
                else
                {
                    deletedMessage = "Form not found.";
                }
                StateHasChanged();
                return;
            }

            form = await respForm.Content.ReadFromJsonAsync<Form>();
            var respData = await Http.GetAsync($"api/forms/{FormId}/responses");
            if (!respData.IsSuccessStatusCode)
            {
                deletedMessage = "Unable to load responses.";
                StateHasChanged();
                return;
            }
            responses = await respData.Content.ReadFromJsonAsync<List<Dictionary<string, object>>>();

            var existingStatuses = responses
                .Where(r => r.TryGetValue("Status", out var s) && !string.IsNullOrWhiteSpace(s?.ToString()))
                .Select(r => r["Status"].ToString())
                .Distinct();
            foreach (var s in existingStatuses)
            {
                if (!statusOptions.Contains(s)) statusOptions.Add(s);
            }

            var savedIcons = await JS.InvokeAsync<string>("localStorage.getItem", $"form_{FormId}_statusIcons");
            if (!string.IsNullOrWhiteSpace(savedIcons))
            {
                var stored = JsonSerializer.Deserialize<Dictionary<string, string>>(savedIcons) ?? new();
                foreach (var kv in stored)
                {
                    statusIcons[kv.Key] = kv.Value;
                    if (!statusOptions.Contains(kv.Key)) statusOptions.Add(kv.Key);
                }
            }

            var fieldKeys = form.Fields
                .Where(f => f.FieldType != "section" && f.FieldType != "title" && f.FieldType != "image" && f.FieldType != "statictext")
                .Select(f => f.Key);
            columns = new[] { "ResponseId", "CreatedAt", "Status" }
                .Concat(fieldKeys)
                .ToArray();
            if (form.RequireLogin)
            {
                columns = columns
                    .Concat(new[] { "ResponderName" })
                    .ToArray();
            }

            exportModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/exportHelper.js");
            StateHasChanged();
        }
    }

    private bool IsFileField(string key)
    {
        var field = form?.Fields.FirstOrDefault(f => f.Key == key);
        return field?.FieldType == "file";
    }

    private bool IsImage(string path)
    {
        var lower = path.ToLowerInvariant();
        return lower.EndsWith(".jpg") || lower.EndsWith(".jpeg") ||
               lower.EndsWith(".png") || lower.EndsWith(".gif") ||
               lower.EndsWith(".bmp") || lower.EndsWith(".webp");
    }

    private string FormatDate(string? val)
    {
        if (DateTime.TryParse(val, out var dt))
            return dt.ToString("MM/dd/yyyy");
        return val ?? string.Empty;
    }

    private string FormatDateTime(string? val)
    {
        if (DateTime.TryParse(val, out var dt))
            return dt.ToString("MM/dd/yyyy h:mm tt");
        return val ?? string.Empty;
    }

    private MarkupString RenderGridText(string? val, FormField field)
    {
        if (string.IsNullOrWhiteSpace(val)) return (MarkupString)string.Empty;
        try
        {
            var rows = JsonSerializer.Deserialize<List<Dictionary<string, string>>>(val) ?? new();
            var opts = JsonSerializer.Deserialize<GridOptions>(field.OptionsJson ?? "{}");
            var cols = opts?.Columns ?? new List<string>();
            var sb = new StringBuilder("<table class='table table-bordered table-sm mb-0'><thead><tr>");
            foreach (var c in cols)
            {
                sb.Append($"<th>{WebUtility.HtmlEncode(c)}</th>");
            }
            sb.Append("</tr></thead><tbody>");
            foreach (var row in rows)
            {
                sb.Append("<tr>");
                foreach (var c in cols)
                {
                    row.TryGetValue(c, out var cell);
                    sb.Append($"<td>{WebUtility.HtmlEncode(cell)}</td>");
                }
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");
            return new MarkupString(sb.ToString());
        }
        catch
        {
            return (MarkupString)val;
        }
    }

    private MarkupString RenderGridRadio(string? val, FormField field)
    {
        if (string.IsNullOrWhiteSpace(val)) return (MarkupString)string.Empty;
        try
        {
            var selections = JsonSerializer.Deserialize<Dictionary<string, string>>(val) ?? new();
            var opts = JsonSerializer.Deserialize<GridOptions>(field.OptionsJson ?? "{}");
            var rows = opts?.Rows ?? new List<string>();
            var cols = opts?.Columns ?? new List<string>();
            var sb = new StringBuilder("<table class='table table-bordered table-sm mb-0'><thead><tr><th></th>");
            foreach (var c in cols)
                sb.Append($"<th>{WebUtility.HtmlEncode(c)}</th>");
            sb.Append("</tr></thead><tbody>");
            foreach (var r in rows)
            {
                sb.Append("<tr>");
                sb.Append($"<td><strong>{WebUtility.HtmlEncode(r)}</strong></td>");
                foreach (var c in cols)
                {
                    var mark = selections.TryGetValue(r, out var sel) && sel == c ? "&#10003;" : string.Empty;
                    sb.Append($"<td>{mark}</td>");
                }
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");
            return new MarkupString(sb.ToString());
        }
        catch
        {
            return (MarkupString)val;
        }
    }

    private MarkupString RenderGridCheckbox(string? val, FormField field)
    {
        if (string.IsNullOrWhiteSpace(val)) return (MarkupString)string.Empty;
        try
        {
            var selections = JsonSerializer.Deserialize<Dictionary<string, List<string>>>(val) ?? new();
            var opts = JsonSerializer.Deserialize<GridOptions>(field.OptionsJson ?? "{}");
            var rows = opts?.Rows ?? new List<string>();
            var cols = opts?.Columns ?? new List<string>();
            var sb = new StringBuilder("<table class='table table-bordered table-sm mb-0'><thead><tr><th></th>");
            foreach (var c in cols)
                sb.Append($"<th>{WebUtility.HtmlEncode(c)}</th>");
            sb.Append("</tr></thead><tbody>");
            foreach (var r in rows)
            {
                sb.Append("<tr>");
                sb.Append($"<td><strong>{WebUtility.HtmlEncode(r)}</strong></td>");
                foreach (var c in cols)
                {
                    var mark = selections.TryGetValue(r, out var list) && list.Contains(c) ? "&#10003;" : string.Empty;
                    sb.Append($"<td>{mark}</td>");
                }
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");
            return new MarkupString(sb.ToString());
        }
        catch
        {
            return (MarkupString)val;
        }
    }

    private string FormatValue(object? raw)
    {
        if (raw is JsonElement je)
        {
            if (je.ValueKind == JsonValueKind.Array)
            {
                return string.Join(", ", je.EnumerateArray().Select(e => e.ToString()));
            }
            if (je.ValueKind == JsonValueKind.Object)
            {
                return je.GetRawText();
            }
            return je.ToString();
        }
        return raw?.ToString() ?? string.Empty;
    }

    private class GridOptions
    {
        public List<string>? Rows { get; set; }
        public List<string>? Columns { get; set; }
    }

    private async Task OnStatusChanged(Dictionary<string, object> row, string value)
    {
        if (value == "__custom")
        {
            var result = await DialogService.OpenAsync<StatusLabelDialog>("Add Label",
                new Dictionary<string, object> { { "Icons", iconChoices } });
            if (result is StatusLabel custom && !string.IsNullOrWhiteSpace(custom.Label))
            {
                if (!statusOptions.Contains(custom.Label)) statusOptions.Add(custom.Label);
                statusIcons[custom.Label] = custom.Icon;
                await JS.InvokeVoidAsync("localStorage.setItem", $"form_{FormId}_statusIcons", JsonSerializer.Serialize(statusIcons));
                await UpdateStatus(row["ResponseId"], custom.Label);
                row["Status"] = custom.Label;
            }
        }
        else
        {
            await UpdateStatus(row["ResponseId"], value);
            row["Status"] = value;
        }
    }

    async Task UpdateStatus(object idObj, string? status)
    {
        if (idObj == null) return;
        int id;
        if (idObj is JsonElement je && je.ValueKind == JsonValueKind.Number)
        {
            id = je.GetInt32();
        }
        else
        {
            id = Convert.ToInt32(idObj);
        }

        await Http.PutAsJsonAsync($"api/forms/{FormId}/responses/{id}/status", new { Status = status ?? string.Empty });

        var row = responses.FirstOrDefault(r =>
        {
            if (r.TryGetValue("ResponseId", out var val))
            {
                if (val is JsonElement je2 && je2.ValueKind == JsonValueKind.Number)
                    return je2.GetInt32() == id;
                try
                {
                    return Convert.ToInt32(val) == id;
                }
                catch
                {
                    return false;
                }
            }
            return false;
        });
        if (row != null) row["Status"] = status;
    }

    private async Task DownloadCsv()
    {
        if (exportModule is not null)
        {
            await exportModule.InvokeVoidAsync("downloadTableCsv", "responsesTable", $"{form?.Name ?? "responses"}.csv");
        }
        else
        {
            await JS.InvokeVoidAsync("downloadTableCsv", "responsesTable", $"{form?.Name ?? "responses"}.csv");
        }
    }

    private async Task DownloadPdf()
    {
        if (exportModule is not null)
        {
            await exportModule.InvokeVoidAsync("exportTableToPdf", "responsesTable", $"{form?.Name ?? "responses"}.pdf");
        }
        else
        {
            await JS.InvokeVoidAsync("exportTableToPdf", "responsesTable", $"{form?.Name ?? "responses"}.pdf");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (exportModule is not null)
        {
            await exportModule.DisposeAsync();
        }
    }
}
